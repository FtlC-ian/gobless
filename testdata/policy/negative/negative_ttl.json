{
  "name": "negative_ttl",
  "description": "Caller requests a negative TTL.",
  "request": {
    "cert_type": "user",
    "principals": [
      "alice"
    ],
    "ttl_seconds": -60,
    "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITestFixtureOnly user@example"
  },
  "iam_context": {
    "arn": "arn:aws:iam::111122223333:user/alice",
    "account_id": "111122223333",
    "username": "alice"
  },
  "policy": {
    "expected_account_id": "111122223333",
    "allow_privileged_principals": [],
    "max_ttl_seconds": 3600
  },
  "expected": {
    "decision": "deny",
    "reason": "ttl_not_positive",
    "no_leak_assertions": [
      "-----BEGIN",
      "aws_secret",
      "AWS_SECRET_ACCESS_KEY",
      "panic",
      "goroutine ",
      "AWS_SESSION_TOKEN",
      "x-amz-security-token",
      "runtime error"
    ]
  }
}
